  19              $daysOfWeek = [1 => 'Thứ Hai', 2 => 'Thứ Ba', 3 => 'Thứ Tư', 4 => 'Thứ Năm', 5 => 'Thứ Sáu', 6 => 'Thứ Bảy', 0 => 'Chủ Nhật'];

  21  
  22:             <?php foreach ($daysOfWeek as $dayIndex => $dayName): ?>
  23:                 <div class="mb-4 p-3 border rounded bg-light">
