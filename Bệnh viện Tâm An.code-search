   46:     <a class="logo" href="/">
   47          {{ if .Site.Params.Images.logo }}
   48:             <span class="icon">
   49:                 <img src="{{ .Site.Params.Images.logo | relURL }}" width="50" height="40" alt="{{ .Site.Title }} - {{ .Site.Params.tagline }}">
   50:             </span>
   51          {{ end }}
   52:         <span class="name">{{ .Site.Title }}</span>
   53:         <span class="tagline">{{ .Site.Params.tagline }}</span>
