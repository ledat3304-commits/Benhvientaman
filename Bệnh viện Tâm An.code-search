  28:                             <tr>
  29:                                 <td colspan="5" class="text-center text-muted">Chưa có lịch hẹn nào.</td>
  30:                             </tr>
  31:                         <?php else: ?>
  32:                             <?php foreach ($appointments as $apt): ?>
  33:                                 <tr>
  34:                                     <td><?= htmlspecialchars($apt['TenBenhNhan']) ?></td>
  35:                                     <td><?= date('d/m/Y H:i', strtotime($apt['ThoiGianKham'])) ?></td>
  36:                                     <td><?= htmlspecialchars($apt['LyDoKham']) ?></td>
  37:                                     <td>
  38:                                         <span class="badge bg-<?= getStatusBadgeClass($apt['TrangThai']) ?>">
  39:                                             <?= htmlspecialchars($apt['TrangThai']) ?>
  40:                                         </span>
  41:                                     </td>
  42:                                     <td class="text-center">
  43:                                         <a href="/appointments/<?= $apt['LichKhamID'] ?>" class="btn btn-sm btn-info" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
  44:                                         <?php if ($apt['TrangThai'] == 'ChoXacNhan'): ?>
  45:                                             <form action="/appointments/<?= $apt['LichKhamID'] ?>/status" method="POST" class="d-inline">
  46:                                                 <input type="hidden" name="status" value="DaXacNhan">
  47:                                                 <button type="submit" class="btn btn-sm btn-success" title="Xác nhận"><i class="fas fa-check"></i></button>
  48:                                             </form>
  49:                                             <form action="/appointments/<?= $apt['LichKhamID'] ?>/status" method="POST" class="d-inline">
  50:                                                 <input type="hidden" name="status" value="DaHuy">
  51:                                                 <button type="submit" class="btn btn-sm btn-danger" title="Hủy"><i class="fas fa-times"></i></button>
  52:                                             </form>
  53:                                         <?php endif; ?>
  54:                                     </td>
  55:                                 </tr>
  56:                             <?php endforeach; ?>
  57:                         <?php endif; ?>
  58:                     </tbody>
  59:                 </table>
  60:             </div>
  61:         </div>
  62:     </div>
  63: </div>
