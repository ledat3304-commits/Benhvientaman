   79:                     </a>
   80:                 </li>
   81                  {{ end }}
   82:             </ul>
   83          {{ end }}
   84:     </menu>
   85:     <article>
   86          {{ template "main" . }}
   87:     </article>
   88: </main>
   89  
   90: <footer>
   91:     <span>&copy; Copyright <a href="https://thephpleague.com">The League of Extraordinary Packages</a>.</span>
   92:     <span>Site design by <a href="https://reinink.ca">Jonathan Reinink</a>.</span>
   93: </footer>
   94  
