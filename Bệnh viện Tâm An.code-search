  28:                                 <div class="row g-2 mb-2 align-items-center time-slot">
  29:                                     <div class="col"><input type="time" class="form-control" name="schedules[<?= $dayIndex ?>][start][]" value="<?= $slot['GioBatDau'] ?>" required></div>
  30:                                     <div class="col-auto">-</div>
  31:                                     <div class="col"><input type="time" class="form-control" name="schedules[<?= $dayIndex ?>][end][]" value="<?= $slot['GioKetThuc'] ?>" required></div>
