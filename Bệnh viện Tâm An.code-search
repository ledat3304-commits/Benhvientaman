  34:                             <?php endforeach; ?>
  35:                         <?php endif; ?>
  36:                     </div>
  37:                     <button type="button" class="btn btn-sm btn-outline-primary mt-2 add-slot-btn" data-day="<?= $dayIndex ?>"><i class="fas fa-plus me-1"></i>Thêm khung giờ</button>
  38:                 </div>
  39:             <?php endforeach; ?>
  40  
  41:             <div class="d-grid mt-4">
